# Copy this file to .env and fill in your own values. Never commit .env.
# FirstRun reads it at startup. It is NOT passed into the projects it checks.

# Gemini key from https://aistudio.google.com/apikey
# Leave it as is and FirstRun runs with its offline rules instead.
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Gemini model id (default is the gemini-flash-latest alias)
# FIRSTRUN_MODEL=gemini-flash-latest
